{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(fvm flutter analyze:*)",
      "Bash(fvm flutter test:*)",
      "Bash(fvm flutter pub get:*)",
      "Bash(fvm flutter gen-l10n:*)",
      "Bash(fvm dart format:*)",
      "Bash(fvm dart fix:*)",
      "Bash(fvm dart pub get:*)",
      "Bash(fvm dart run build_runner:*)",
      "Bash(fvm dart run bloc_tools:bloc lint:*)",
      "Bash(make clean)"
    ],
    "ask": [
      "Bash(make deploy-:*)",
      "Bash(fastlane:*)",
      "Bash(fvm flutter build:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "flutter-agent-kit": {
      "source": {
        "source": "github",
        "repo": "onaya7/flutter-agent-kit"
      },
      "autoUpdate": true
    },
    "dart-flutter": {
      "source": {
        "source": "github",
        "repo": "flutter/agent-plugins"
      }
    }
  },
  "enabledPlugins": {
    "flutter-kit@flutter-agent-kit": true,
    "dart-flutter@dart-flutter": true
  }
}
