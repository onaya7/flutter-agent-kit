{
  "description": "Flutter guardrails: block edits to generated Dart, format Dart on write, flag stale feature docs. Every script exits early outside a Flutter project.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard-generated.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for generated files"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/format-dart.sh\"",
            "timeout": 30,
            "statusMessage": "Formatting Dart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-feature-docs.sh\"",
            "timeout": 15,
            "statusMessage": "Checking feature docs"
          }
        ]
      }
    ]
  }
}
